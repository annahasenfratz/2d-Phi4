#!/usr/bin/env bash
set -euo pipefail

# MIT-style independence-Metropolis inverse-blocking diagnostic.
# Default: L8 -> L16 diagnostic replay using saved L8 coarse configs.

###############################################################################
# Edit parameters here.
###############################################################################

LC="8"
LF="16"
KAPPA_C="0.28" #"0.323124"
KAPPA_F="0.30" #"0.323124"

PROPOSALS="1024"                 # smoke: 32, validation: 512, pilot: 5000
BATCH_SIZE="256"
SEED="2026071021"
DEVICE="cpu"

COARSE_MODE="diagnostic_replay_not_exact_production"
COARSE_ENSEMBLE="auto"
COARSE_ENSEMBLE_ROOT="perfect_blocking_upsampling/outputs/controlled_patch_lam0p2/L16to32_exact_direct_L16_kappac_scan/coarse_ensembles"
NATIVE_REFERENCE="perfect_blocking_upsampling/outputs/lam0p2_kappa0p323124/native/L${LF}/configs.npz"

KERNEL_PATH="perfect_blocking_upsampling/outputs/controlled_patch_lam0p2/rand5x5_0084_repro_workflow/rand5x5_0084_kernel.json"
AR_CHECKPOINT="perfect_blocking_upsampling/outputs/controlled_patch_lam0p2/rand5x5_0084_repro_workflow/production/width0p003_tail0p003/autoregressive_checkpoint.pt"
BASELINE_CHECKPOINT="perfect_blocking_upsampling/outputs/controlled_patch_lam0p2/rand5x5_0084_residual_flow_pilot/checkpoints/checkpoint_best_residual_flow.pt"

OUT_ROOT="perfect_blocking_upsampling/outputs/controlled_patch_lam0p2/mit_style_inverse_blocking_L8to16"
RUN_NAME=""
RUN_IN_NOHUP="0"
DRY_RUN="${DRY_RUN:-0}"

###############################################################################

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

tag_float() {
  local x="$1"
  x="${x/-/m}"
  x="${x//./p}"
  echo "$x"
}

if [[ -x "../../.venv/bin/python" ]]; then
  PYTHON="../../.venv/bin/python"
elif [[ -x ".venv/bin/python" ]]; then
  PYTHON=".venv/bin/python"
else
  echo "ERROR: could not find ../../.venv/bin/python or .venv/bin/python" >&2
  exit 2
fi

if [[ "$COARSE_ENSEMBLE" == "auto" ]]; then
  kc_tag="$(tag_float "$KAPPA_C")"
  kc_tag6="$(tag_float "$(printf '%.6f' "$KAPPA_C")")"
  kc_tag4="$(tag_float "$(printf '%.4f' "$KAPPA_C")")"
  candidates=(
    "$COARSE_ENSEMBLE_ROOT/lam0p2_kappac${kc_tag6}_L${LC}_N5000/configs.npz"
    "$COARSE_ENSEMBLE_ROOT/lam0p2_kappac${kc_tag}_L${LC}_N5000/configs.npz"
    "$COARSE_ENSEMBLE_ROOT/lam0p2_kappac${kc_tag4}_L${LC}_N5000/configs.npz"
    "perfect_blocking_upsampling/outputs/lam0p2_kappa${kc_tag6}/native/L${LC}/configs.npz"
    "perfect_blocking_upsampling/outputs/lam0p2_kappa${kc_tag}/native/L${LC}/configs.npz"
    "perfect_blocking_upsampling/outputs/lam0p2_kappa${kc_tag4}/native/L${LC}/configs.npz"
  )
  if [[ "$KAPPA_C" == "0.323124" ]]; then
    candidates+=("perfect_blocking_upsampling/outputs/lam0p2_kappa0p323124/native/L${LC}/configs.npz")
  fi
  COARSE_ENSEMBLE=""
  for candidate in "${candidates[@]}"; do
    if [[ -e "$candidate" ]]; then
      COARSE_ENSEMBLE="$candidate"
      break
    fi
  done
  if [[ -z "$COARSE_ENSEMBLE" ]]; then
    cat >&2 <<EOF
ERROR: COARSE_ENSEMBLE=auto could not find L${LC} configs for KAPPA_C=$KAPPA_C.

Looked for:
$(printf '  %s\n' "${candidates[@]}")
EOF
    exit 2
  fi
fi

for path in "$COARSE_ENSEMBLE" "$NATIVE_REFERENCE" "$KERNEL_PATH" "$AR_CHECKPOINT" "$BASELINE_CHECKPOINT"; do
  if [[ ! -e "$path" ]]; then
    echo "ERROR: missing required path: $path" >&2
    exit 2
  fi
done

if [[ -z "$RUN_NAME" ]]; then
  kc_tag="$(tag_float "$KAPPA_C")"
  kf_tag="$(tag_float "$KAPPA_F")"
  RUN_NAME="L${LC}to${LF}_kc${kc_tag}_kf${kf_tag}_P${PROPOSALS}_$(date +%Y%m%d_%H%M%S)"
fi

OUT_DIR="$OUT_ROOT/$RUN_NAME"
LOG_DIR="$OUT_DIR/logs"
mkdir -p "$LOG_DIR"
LOG="$LOG_DIR/mit_style_inverse_blocking.log"
NOHUP_LOG="$LOG_DIR/mit_style_inverse_blocking.nohup.log"
PID_FILE="$LOG_DIR/mit_style_inverse_blocking.pid"

cmd=(
  "$PYTHON" -u -B perfect_blocking_upsampling/scripts/run_lam0p2_mit_style_inverse_blocking_L8to16.py
  --from-L "$LC"
  --to-L "$LF"
  --kappa-c "$KAPPA_C"
  --kappa-f "$KAPPA_F"
  --proposals "$PROPOSALS"
  --batch-size "$BATCH_SIZE"
  --seed "$SEED"
  --device "$DEVICE"
  --coarse-mode "$COARSE_MODE"
  --coarse-ensemble "$COARSE_ENSEMBLE"
  --native-reference "$NATIVE_REFERENCE"
  --kernel-path "$KERNEL_PATH"
  --ar-checkpoint "$AR_CHECKPOINT"
  --baseline-checkpoint "$BASELINE_CHECKPOINT"
  --out-dir "$OUT_DIR"
)

printf -v CMD_QUOTED '%q ' "${cmd[@]}"
printf -v LOG_QUOTED '%q' "$LOG"

cat <<EOF
MIT-style inverse-blocking independence sampler
  LC=$LC LF=$LF
  KAPPA_C=$KAPPA_C KAPPA_F=$KAPPA_F
  PROPOSALS=$PROPOSALS COARSE_MODE=$COARSE_MODE
  COARSE_ENSEMBLE=$COARSE_ENSEMBLE
  OUT_DIR=$OUT_DIR
  LOG=$LOG
  command: $CMD_QUOTED
EOF

if [[ "$DRY_RUN" == "1" ]]; then
  echo "[dry-run] not launching"
  exit 0
fi

{
  echo "submitted_at: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "root: $ROOT"
  echo "LC: $LC"
  echo "LF: $LF"
  echo "kappa_c: $KAPPA_C"
  echo "kappa_f: $KAPPA_F"
  echo "proposals: $PROPOSALS"
  echo "coarse_mode: $COARSE_MODE"
  echo "coarse_ensemble: $COARSE_ENSEMBLE"
  echo "native_reference: $NATIVE_REFERENCE"
  echo "kernel_path: $KERNEL_PATH"
  echo "ar_checkpoint: $AR_CHECKPOINT"
  echo "baseline_checkpoint: $BASELINE_CHECKPOINT"
  echo "out_dir: $OUT_DIR"
  echo "log: $LOG"
  echo "command: $CMD_QUOTED"
} > "$OUT_DIR/submit_manifest.txt"

if [[ "$RUN_IN_NOHUP" == "1" ]]; then
  nohup bash -lc "set -euo pipefail; export PYTHONUNBUFFERED=1; $CMD_QUOTED 2>&1 | tee $LOG_QUOTED" > "$NOHUP_LOG" 2>&1 &
  pid=$!
  echo "$pid" > "$PID_FILE"
  echo "Started background job:"
  echo "  PID=$pid"
  echo "  LOG=$LOG"
else
  PYTHONUNBUFFERED=1 "${cmd[@]}" 2>&1 | tee "$LOG"
fi
