#!/usr/bin/env bash
set -euo pipefail

###############################################################################
# Lambda=1.0 direct MIT-style inverse-blocking reference submit script.
#
# Edit the parameter block below. Normal use launches a background nohup job:
#
#   ./submit_mit_style
#
# Use --prepare-only to print the resolved command without starting a run, or
# RUN_IN_NOHUP=0 ./submit_mit_style for foreground execution.
###############################################################################

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

###############################################################################
# Edit parameters here.
###############################################################################

LAMBDA="${LAMBDA:-1.0}"
KAPPA_C="${KAPPA_C:-0.340301}"
KAPPA_F="${KAPPA_F:-0.340301}"
LC="${LC:-16}"
LF="${LF:-32}"

# Use the final eta-included 5x5 kernel and the matching wrapped 5x5 flow used
# in the prior coarse-detail runs. Its procedural convolutional map can be
# instantiated at L8 for this L8->L16 reference test.
KERNEL_PATH="${KERNEL_PATH:-perfect_blocking/perfect_blocking_lam1p0/kernels/final/chosen_kernel.json}"
FLOW_CHECKPOINT="${FLOW_CHECKPOINT:-perfect_blocking_upsampling/runs/lam1p0/training/lam1p0_L16to32_newkernel_rqspline_N2000_action_lowtail_from_N2000_bestpatch_20260719T171401Z/checkpoints/checkpoint_best_patch.pt}"

# q_c(c) is exp[-S_c(c)], represented by an iid native-action coarse ensemble.
# The native fine fields are only used for the blocked-native sweep-0 control.
COARSE_PROPOSAL_SOURCE="${COARSE_PROPOSAL_SOURCE:-auto}"
NATIVE_FINE_SOURCE="${NATIVE_FINE_SOURCE:-auto}"

N_CHAINS="${N_CHAINS:-250}"
N_SWEEPS="${N_SWEEPS:-400}"
SAVE_SWEEPS="${SAVE_SWEEPS:-$(seq -s, 0 5 400)}"
BATCH_SIZE="${BATCH_SIZE:-64}"
SEED="${SEED:-2026072231}"
DEVICE="${DEVICE:-cpu}"
INITIAL_START_INDEX="${INITIAL_START_INDEX:-0}"
# The proposal pool is a consecutive, auditable range. Individual direct-MIT
# proposals remain random draws with replacement from this pool.
COARSE_SOURCE_START_INDEX="${COARSE_SOURCE_START_INDEX:-1000}"
COARSE_SOURCE_COUNT="${COARSE_SOURCE_COUNT:-1250}"

OUTPUT_ROOT="${OUTPUT_ROOT:-auto}"
RUN_LABEL="${RUN_LABEL:-wrappedFlow_final5x5_directMIT_blockedNativeInit}"
RUN_IN_NOHUP="${RUN_IN_NOHUP:-1}"

###############################################################################

PREPARE_ONLY=0
for arg in "$@"; do
  case "$arg" in
    --prepare-only) PREPARE_ONLY=1 ;;
    *) printf 'unknown argument: %s\n' "$arg" >&2; exit 2 ;;
  esac
done

[[ "$LAMBDA" == "1.0" && "$KAPPA_C" == "0.340301" && "$KAPPA_F" == "0.340301" ]] || {
  printf 'This direct-MIT reference is frozen for lambda=1 and kappa=0.340301.\n' >&2
  exit 2
}
if [[ "$LC" == "8" && "$LF" == "16" ]]; then
  DEFAULT_COARSE="data/configs_phi4_2d/lam1p0_kappac0p340301_L8/configs.npz"
  DEFAULT_FINE="data/configs_phi4_2d/lam1p0_kappac0p340301_L16/configs.npz"
elif [[ "$LC" == "16" && "$LF" == "32" ]]; then
  DEFAULT_COARSE="data/configs_phi4_2d/lam1p0_kappac0p340301_L16/configs.npz"
  DEFAULT_FINE="data/configs_phi4_2d/lam1p0_kappac0p340301_L32/configs.npz"
else
  printf 'Supported direct-MIT pairs are L8->L16 and L16->L32; got L%s->L%s.\n' "$LC" "$LF" >&2
  exit 2
fi
[[ "$COARSE_PROPOSAL_SOURCE" == "auto" ]] && COARSE_PROPOSAL_SOURCE="$DEFAULT_COARSE"
[[ "$NATIVE_FINE_SOURCE" == "auto" ]] && NATIVE_FINE_SOURCE="$DEFAULT_FINE"
[[ "$OUTPUT_ROOT" == "auto" ]] && OUTPUT_ROOT="perfect_blocking_upsampling/outputs/controlled_patch_lam1p0/mit_style_inverse_blocking_L${LC}to${LF}"
PYTHON="../../.venv/bin/python"
DRIVER="perfect_blocking_upsampling/scripts/run_lam1p0_mit_style_inverse_blocking_L8to16.py"
for required in "$PYTHON" "$DRIVER" "$KERNEL_PATH" "$FLOW_CHECKPOINT" "$COARSE_PROPOSAL_SOURCE" "$NATIVE_FINE_SOURCE"; do
  [[ -e "$required" ]] || { printf 'missing required path: %s\n' "$required" >&2; exit 1; }
done

STAMP="$(date +%Y%m%dT%H%M%SZ)"
RUN_ID="mit_bL${LF}_wrapped_RQS_cfg${INITIAL_START_INDEX}_N${N_CHAINS}_S${N_SWEEPS}_${RUN_LABEL}_${STAMP}"
RUN_DIR="$OUTPUT_ROOT/$RUN_ID"
CMD=("$PYTHON" -B "$DRIVER" --run-dir "$RUN_DIR" --coarse-proposal-source "$COARSE_PROPOSAL_SOURCE" --native-reference-source "$NATIVE_FINE_SOURCE" --flow-checkpoint "$FLOW_CHECKPOINT" --kernel-path "$KERNEL_PATH" --from-L "$LC" --to-L "$LF" --n-chains "$N_CHAINS" --n-sweeps "$N_SWEEPS" --save-sweeps "$SAVE_SWEEPS" --batch-size "$BATCH_SIZE" --seed "$SEED" --device "$DEVICE" --initial-start-index "$INITIAL_START_INDEX" --coarse-source-start-index "$COARSE_SOURCE_START_INDEX")
if [[ -n "$COARSE_SOURCE_COUNT" ]]; then
  CMD+=(--coarse-source-count "$COARSE_SOURCE_COUNT")
fi

printf 'run directory: %s\n' "$RUN_DIR"
printf 'command: '
printf '%q ' "${CMD[@]}"
printf '\n'
if [[ "$PREPARE_ONLY" == "1" ]]; then
  printf 'Prepared only; no process started.\n'
  exit 0
fi

mkdir -p "$RUN_DIR/logs"
{
  printf 'run_id=%s\n' "$RUN_ID"
  printf 'lambda=%s kappa_c=%s kappa_f=%s Lc=%s Lf=%s\n' "$LAMBDA" "$KAPPA_C" "$KAPPA_F" "$LC" "$LF"
  printf 'command='
  printf '%q ' "${CMD[@]}"
  printf '\n'
} > "$RUN_DIR/submit_manifest.txt"
if [[ "$RUN_IN_NOHUP" == "1" ]]; then
  nohup "${CMD[@]}" > "$RUN_DIR/logs/run.log" 2>&1 &
  printf '%s\n' "$!" > "$RUN_DIR/submit_pid.txt"
  printf 'started background PID %s\n' "$!"
else
  exec "${CMD[@]}"
fi
